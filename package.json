{
  "name": "screencye-mcp",
  "version": "0.1.0",
  "description": "Eyes for text-only LLMs. Decode screenshots into exact structured text (words, coordinates, sizes, colors, spacing) via pure-code CV + OCR — zero VRAM, no vision model needed. MCP server for Claude Code / Hermes / agents.",
  "main": "src/index.js",
  "type": "commonjs",
  "bin": {
    "screencye": "src/cli.js",
    "screencye-mcp": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/cli.js",
    "mcp": "node src/server.mjs",
    "cli": "node src/cli.js",
    "test": "node test/run-tests.js"
  },
  "keywords": [
    "mcp",
    "ocr",
    "screenshot",
    "computer-use",
    "paddleocr",
    "onnx",
    "vision",
    "agent"
  ],
  "author": "VELOCE AI",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oovz/esearch-ocr": "^8.4.4",
    "canvas": "^3.2.3",
    "onnxruntime-node": "^1.27.0",
    "zod": "^4.4.3"
  }
}
